MONGODB_URI=mongodb://localhost:27017/staffsync
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NODE_ENV=development

# Uncomment and set to your BACKEND deployment base URL ONLY if you deployed
# frontend & backend on SEPARATE Vercel projects (or other hosts).
# Examples:
#   VITE_API_URL=https://staffsync-backend.vercel.app/api
#   VITE_API_URL=https://api.yourcompany.com
#
# If frontend + backend are in the SAME project (repo root as both),
# leave this commented out — requests go to relative /api via same-origin.
# VITE_API_URL=
